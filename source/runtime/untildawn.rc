// UntilDawn.exe resources. Release builds (w38_rel) have no icon: the window icon is made at run time from the player's own sce_sys\icon0.png (e3_icon.c). A developer build may still add untildawn.ico (make_icon.py).
1 ICON "untildawn.ico"
1 VERSIONINFO
FILEVERSION 0,5,0,0
PRODUCTVERSION 0,5,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Until Dawn (PC runtime)"
      VALUE "ProductName", "Until Dawn"
      VALUE "OriginalFilename", "UntilDawn.exe"
      VALUE "FileVersion", "0.5.0"
      VALUE "ProductVersion", "0.5.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
